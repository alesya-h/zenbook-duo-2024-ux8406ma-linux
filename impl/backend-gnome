#!/usr/bin/env bash

# GNOME/Mutter backend for duo: display layouts, monitor status, input mapping.

here="$(dirname "$(realpath "$0")")"

top_connector=eDP-1
bottom_connector=eDP-2

# ELAN9008 drives the top digitizer and ELAN9009 the bottom one on every
# UX8406MA. The product id after the vendor differs between panel variants, so
# it is read off the device rather than written down.
top_digitizer_acpi=ELAN9008
bottom_digitizer_acpi=ELAN9009

function mutter-feature-enabled {
  dconf read "/org/gnome/mutter/experimental-features"|grep "$1" > /dev/null
}

# Asks mutter for the panel geometry that used to be a block of constants per
# variant. Deferred rather than run at startup because status-internal is polled
# every few seconds by the status script and needs none of it.
function read-panel {
  local mode_id height scale variable
  read -r mode_id height scale variable \
    < <("$here/display-info.py" panel "$top_connector") || return 1

  preferred_resolution="$mode_id"
  if [ "$variable" = 1 ] && mutter-feature-enabled variable-refresh-rate ; then
    preferred_resolution="$preferred_resolution+vrr"
  fi

  ui_scale="$scale"
  # The bottom panel starts where the top one ends, in logical pixels.
  y_offset="$(awk -v h="$height" -v s="$scale" 'BEGIN{printf "%d", h/s+0.5}')"
}

# The EDID triple GNOME keys a tablet or touchscreen mapping on, plus the
# connector, in the form dconf wants.
function output-spec {
  local vendor product serial
  read -r vendor product serial < <("$here/display-info.py" spec "$1") || return 1
  printf "['%s', '%s', '%s', '%s']" "$vendor" "$product" "$serial" "$1"
}

function digitizer-id {
  local dir
  for dir in /sys/bus/i2c/devices/i2c-"$1":*/[0-9]*:*:*.*; do
    [ -e "$dir" ] || continue
    basename "$dir" |
      awk -F: '{printf "%s:%s\n", tolower($2), tolower(substr($3, 1, index($3, ".") - 1))}'
    return 0
  done
  return 1
}

case "$1" in
  set-layout)
    read-panel || { echo "backend-gnome: cannot read panel geometry from mutter" >&2; exit 1; }
    case "$2" in
      top)
        gnome-monitor-config set \
          -LpM $top_connector -m $preferred_resolution -s $ui_scale -x 0 -y 0
        ;;
      both)
        gnome-monitor-config set \
          -LpM $top_connector    -m $preferred_resolution -s $ui_scale -x 0 -y 0 \
          -LM  $bottom_connector -m $preferred_resolution -s $ui_scale -x 0 -y $y_offset
        ;;
      bottom)
        gnome-monitor-config set \
          -LpM $bottom_connector -m $preferred_resolution -s $ui_scale -x 0 -y 0
        ;;
      left-up)
        gnome-monitor-config set \
          -LpM $bottom_connector -m $preferred_resolution -s $ui_scale -t left  -x 0         -y 0 \
          -LM  $top_connector    -m $preferred_resolution -s $ui_scale -t left  -x $y_offset -y 0
        ;;
      right-up)
        gnome-monitor-config set \
          -LM  $top_connector    -m $preferred_resolution -s $ui_scale -t right -x 0         -y 0 \
          -LpM $bottom_connector -m $preferred_resolution -s $ui_scale -t right -x $y_offset -y 0
        ;;
      *) echo "Usage: backend-gnome set-layout <top|both|bottom|left-up|right-up>" >&2; exit 1
    esac
    ;;
  external-display-connected)
    [ "$(gnome-monitor-config list|grep display-name|grep -v 'Built-in display'|wc -l)" != "0" ]
    ;;
  active-external-displays)
    gnome-monitor-config list|grep -vE "$top_connector|$bottom_connector"|sed -nE 's/Monitor \[ (.+) \] ON/\1/p'
    ;;
  status-internal)
    internal_monitors="$(gnome-monitor-config list|grep -E "Monitor \\[ ($top_connector|$bottom_connector) \\] ON")"
    case "$(echo "$internal_monitors"|grep -v -E "^$"|wc -l)" in
      0) echo "none" ;;
      1) case "$(echo "$internal_monitors"|grep ON)" in
           "Monitor [ $top_connector ] ON") echo top ;;
           "Monitor [ $bottom_connector ] ON") echo bottom ;;
         esac ;;
      2) echo "both" ;;
    esac
    ;;
  map-inputs)
    top_output="$(output-spec "$top_connector")" || exit 1
    bottom_output="$(output-spec "$bottom_connector")" || exit 1
    top_id="$(digitizer-id "$top_digitizer_acpi")" || exit 1
    bottom_id="$(digitizer-id "$bottom_digitizer_acpi")" || exit 1
    for type in tablets touchscreens; do
      dconf write "/org/gnome/desktop/peripherals/${type}/${top_id}/output" "$top_output"
      dconf write "/org/gnome/desktop/peripherals/${type}/${bottom_id}/output" "$bottom_output"
    done
    ;;
  toggle-bottom-touch)
    bottom_id="$(digitizer-id "$bottom_digitizer_acpi")" || exit 1
    path="/org/gnome/desktop/peripherals/touchscreens/${bottom_id}/output"
    if [ -z "$(dconf read "$path")" ]; then
      dconf write "$path" "$(output-spec "$bottom_connector")"
    else
      dconf reset "$path"
    fi
    ;;
  *) echo "Usage: backend-gnome <set-layout|external-display-connected|active-external-displays|status-internal|map-inputs|toggle-bottom-touch>" >&2; exit 1
esac
