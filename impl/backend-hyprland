#!/usr/bin/env bash

# Hyprland backend for duo: display layouts, monitor status.
#
# Tablet/touch output mapping is not implemented: Hyprland binds input
# devices to outputs via static `device { output = ... }` stanzas in
# hyprland.conf, reloaded with `hyprctl reload` -- there's no dconf-style
# runtime toggle to hook into like on GNOME.

TOP=eDP-1
BOTTOM=eDP-2

# 3k model
mode="2880x1800@120"
scale=1.66667
y_offset=1080

# 1080p model
#mode="1920x1200@60"
#scale=1
#y_offset=1200

function monitors-json { hyprctl monitors -j; }

function set-monitor { # <name> <x> <y> [transform]
  hyprctl keyword monitor "$1,$mode,${2}x${3},$scale,transform,${4:-0}"
}

function disable-monitor {
  hyprctl keyword monitor "$1,disable"
}

case "$1" in
  set-layout)
    case "$2" in
      top)
        set-monitor $TOP 0 0
        disable-monitor $BOTTOM
        ;;
      both)
        set-monitor $TOP 0 0
        set-monitor $BOTTOM 0 "$y_offset"
        ;;
      bottom)
        set-monitor $BOTTOM 0 0
        disable-monitor $TOP
        ;;
      left-up|right-up)
        # wl_output transform enum: 1 = 90 degrees, 3 = 270 degrees
        [ "$2" = left-up ] && t=1 || t=3
        set-monitor $BOTTOM 0 0 $t
        set-monitor $TOP "$y_offset" 0 $t
        ;;
      *) echo "Usage: backend-hyprland set-layout <top|both|bottom|left-up|right-up>" >&2; exit 1
    esac
    ;;
  external-display-connected)
    [ "$(monitors-json | jq "[.[] | select(.name != \"$TOP\" and .name != \"$BOTTOM\")] | length")" != "0" ]
    ;;
  active-external-displays)
    monitors-json | jq -r ".[] | select(.name != \"$TOP\" and .name != \"$BOTTOM\") | .name"
    ;;
  status-internal)
    top_on="$(monitors-json | jq "any(.[]; .name == \"$TOP\")")"
    bottom_on="$(monitors-json | jq "any(.[]; .name == \"$BOTTOM\")")"
    if $top_on && $bottom_on; then
      echo both
    elif $top_on; then
      echo top
    elif $bottom_on; then
      echo bottom
    else
      echo none
    fi
    ;;
  map-inputs|toggle-bottom-touch)
    echo "duo: not supported on the hyprland backend (needs static device{output=} config + hyprctl reload)" >&2
    exit 1
    ;;
  *) echo "Usage: backend-hyprland <set-layout|external-display-connected|active-external-displays|status-internal|map-inputs|toggle-bottom-touch>" >&2; exit 1
esac
