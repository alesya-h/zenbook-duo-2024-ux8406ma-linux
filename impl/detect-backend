#!/usr/bin/env bash

# Detects the display backend to use and prints its name.

case "${XDG_CURRENT_DESKTOP,,}" in
  *hyprland*)
    echo hyprland
    exit 0
    ;;
  *niri*)
    echo niri
    exit 0
    ;;
  *gnome*)
    echo gnome
    exit 0
    ;;
esac

# Fall back to probing in case XDG_CURRENT_DESKTOP is not set.
if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
  echo hyprland
  exit 0
fi

if [ -n "$NIRI_SOCKET" ]; then
  echo niri
  exit 0
fi

if command -v gnome-monitor-config > /dev/null; then
  echo gnome
  exit 0
fi

echo "duo: no supported display backend detected" >&2
exit 1
