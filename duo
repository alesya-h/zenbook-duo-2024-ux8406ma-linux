#!/usr/bin/env bash

cd "$(dirname "$(realpath "$0")")"

backend="$(impl/detect-backend)" || exit 1

function backend {
  "impl/backend-$backend" "$@"
}

# The absolute PCI path embeds the i2c bus number and the HID instance suffix,
# both of which come from enumeration order and move between boots; the product
# id in the middle also differs between panel variants. The i2c symlink and a
# glob are stable against all three.
#  top_screen_touch_panel="/sys/bus/i2c/devices/i2c-ELAN9008:00/0018:04F3:*"
bottom_screen_touch_panel="/sys/bus/i2c/devices/i2c-ELAN9009:00/0018:04F3:*"

# Likewise card1 is just whichever card the panel came up on.
bottom_backlight="/sys/class/backlight/card*-eDP-2-backlight"

function suenv {
  sudo /usr/bin/env "$@"
}

# udev/99-zenbook-duo.rules gives the wheel group write access to exactly the
# files below, which is a great deal less than the sudoers rule in the README
# hands out. Fall back to sudo so the script still works without the rules.
function wr {
  local value="$1"; shift
  local f
  for f in "$@"; do
    if [ -w "$f" ]; then
      printf '%s\n' "$value" > "$f"
    else
      printf '%s\n' "$value" | suenv tee "$f" > /dev/null
    fi
  done
}

function get-orientation {
  gdbus call --system --dest net.hadess.SensorProxy --object-path /net/hadess/SensorProxy --method org.freedesktop.DBus.Properties.Get net.hadess.SensorProxy AccelerometerOrientation | sed "s/.*<'\([^']*\)'>.*/\1/"
}

function keyboard-is-attached {
  lsusb|grep 0b05:1b2c
}

function keyboard-usb-node {
  lsusb -d 0b05:1b2c|sed -nE 's|^Bus ([0-9]+) Device ([0-9]+):.*|/dev/bus/usb/\1/\2|p'|head -1
}

function set-bottom-screen-touch-inhibition {
  wr "$1" $bottom_screen_touch_panel/input/input*/inhibited
}

case "$1" in
  watch-displays)
    "$0" "$(get-orientation)"
    while inotifywait -e attrib /dev/bus/usb/*/ ; do
      if ! backend external-display-connected; then
        "$0" "$(get-orientation)"
      fi
    done
    ;;
  set-displays)
    if ! backend external-display-connected; then
      "$0" normal
    fi
    ;;
  normal|bottom-up)
    if keyboard-is-attached; then
      "$0" top
    else
      "$0" both
    fi
    ;;
  top)
    backend set-layout top
    set-bottom-screen-touch-inhibition 1
    ;;
  both)
    backend set-layout both
    set-bottom-screen-touch-inhibition 0
    ;;
  bottom)
    backend set-layout bottom
    set-bottom-screen-touch-inhibition 0
    ;;
  left-up)
    backend set-layout left-up
    set-bottom-screen-touch-inhibition 0
    ;;
  right-up)
    backend set-layout right-up
    set-bottom-screen-touch-inhibition 0
    ;;
  status-internal)
    backend status-internal
    ;;
  status)
    backend active-external-displays|grep -vE "^$"|sed -z "s/\n/+/g"
    "$0" status-internal
    ;;
  toggle)
    if [ "$(backend status-internal)" = both ]; then
      "$0" top
    else
      "$0" both
    fi
    ;;
  set-tablet-mapping)
    backend map-inputs
    ;;
  toggle-bottom-touch)
    backend toggle-bottom-touch
    ;;
  bat-limit)
    wr "${2:-80}" /sys/class/power_supply/BAT0/charge_control_end_threshold
    ;;
  sync-backlight)
    wr "$(cat /sys/class/backlight/intel_backlight/brightness)" \
      $bottom_backlight/brightness
    ;;
  set-kb-backlight)
    # The udev rules leave the keyboard's USB node group writable, and then
    # pyusb needs no privileges at all.
    node="$(keyboard-usb-node)"
    if [ -n "$node" ] && [ -w "$node" ]; then
      python3 bk.py "$2"
    else
      suenv python3 bk.py "$2"
    fi
    ;;
  watch-backlight)
    "$0" sync-backlight
    while inotifywait -e modify /sys/class/backlight/intel_backlight/brightness ; do
      "$0" sync-backlight
    done
    ;;
  watch-rotation)
    # iio-sensor-proxy 3.8 appends ", tilt: <value>" to the opening
    # "Has accelerometer (orientation: X, ...)" line, which `cut -d: -f2` turns
    # into "X,tilt", and duo then prints its usage instead of rotating. Match the
    # orientation value itself, on that line and on the later
    # "orientation changed: X" ones, and drop anything that is not a layout we
    # handle, such as "undefined".
    # monitor-sensor needs its own stdbuf too: piped, its stdout is block
    # buffered, so events sit unflushed instead of rotating anything.
    stdbuf -oL monitor-sensor --accel |
      stdbuf -oL sed -nE 's/.*orientation( changed)?: (normal|bottom-up|left-up|right-up).*/\2/p' |
      xargs -I '{}' stdbuf -oL "$0" '{}'
    ;;
  *) echo "Usage: duo <top|bottom|both|set-displays|toggle|status|set-tablet-mapping|bat-limit|sync-backlight|set-kb-backlight|watch-backlight|watch-rotation|watch-displays>"
esac
